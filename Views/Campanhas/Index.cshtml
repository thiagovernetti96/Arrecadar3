@model IEnumerable<Arrecadar3.Models.Campanha>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Titulo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Ongs)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Descricao)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Meta_Arrecadacao)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Valor_Arrecadado)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Data_Inicio)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Foto_Perfil)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Titulo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Ongs.Nome)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Descricao)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Meta_Arrecadacao)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Valor_Arrecadado)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Data_Inicio)
            </td>
            <td>
                    @if (item.Foto_Perfil != null && item.Foto_Perfil.Length > 0)
                    {
                        <img src="data:image/jpeg;base64,@Convert.ToBase64String(item.Foto_Perfil)"
                             alt="Logo da ONG"
                             style="max-width: 80px; height: auto;" />
                    }
                    else
                    {
                        <span>Sem imagem</span>
                    }
            </td>
            <td>
                    <div asp-validation-summary="All" class="text-danger"></div>
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
