@model Arrecadar3.Models.Campanha

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Campanha</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Titulo)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Titulo)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Ongs)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Ongs.Nome)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Descricao)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Descricao)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Meta_Arrecadacao)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Meta_Arrecadacao)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Valor_Arrecadado)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Valor_Arrecadado)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Data_Inicio)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Data_Inicio)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Foto_Perfil)
        </dt>
        <dd class="col-sm-10">
            @if (Model.Foto_Perfil != null && Model.Foto_Perfil.Length > 0)
            {
                <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.Foto_Perfil)"
                     alt="Logo da ONG"
                     class="img-fluid"
                     style="max-width: 300px; height: auto;" />
            }
            else
            {
                <span class="text-muted">Nenhuma imagem cadastrada</span>
            }
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
