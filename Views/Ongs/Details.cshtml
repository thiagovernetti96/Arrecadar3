@model Arrecadar3.Models.Ong

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Ong</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Nome)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nome)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.User)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.User.Email)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Cnpj)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Cnpj)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Telefone)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Telefone)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Area_Atuacao)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Area_Atuacao)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Descricao)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Descricao)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Foto_Perfil)
        </dt>
        <dd class="col-sm-10">
            @if (Model.Foto_Perfil != null && Model.Foto_Perfil.Length > 0)
            {
                <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.Foto_Perfil)"
                     alt="Logo da ONG"
                     class="img-fluid"
                     style="max-width: 300px; height: auto;" />
            }
            else
            {
                <span class="text-muted">Nenhuma imagem cadastrada</span>
            }
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
